# Firebase web configuration is public client configuration, not a secret.
# Restrict its use in the Firebase console; never put service-account credentials here.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Local Cloudflare Worker API. Replace with the deployed Worker URL for a live environment.
VITE_API_BASE_URL=http://localhost:8787/api/v1
